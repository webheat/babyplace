.voice-btn-wrap {
  position: fixed;
  bottom: 200rpx;
  right: 40rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.voice-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #60a5fa);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.4);
  transition: all 0.3s ease;
  position: relative;
}

.voice-btn.listening {
  background: linear-gradient(135deg, #ef4444, #f87171);
  box-shadow: 0 8rpx 32rpx rgba(239, 68, 68, 0.5);
  transform: scale(1.1);
}

.voice-btn.disabled {
  background: #d1d5db;
  box-shadow: none;
  opacity: 0.6;
}

.voice-icon {
  font-size: 48rpx;
  z-index: 1;
}

/* 脉冲动画 */
.pulse-ring {
  position: absolute;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(239, 68, 68, 0.5);
  animation: pulse 1.5s ease-out infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}

/* 识别状态 */
.voice-status {
  margin-top: 16rpx;
  background: rgba(0, 0, 0, 0.75);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  max-width: 480rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  margin-right: 12rpx;
  animation: blink 1s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.status-text {
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
}

.realtime-text {
  font-size: 24rpx;
  color: #fbbf24;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
