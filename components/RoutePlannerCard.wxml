<view class="route-card data-v-32c48fa7"><view class="section-head section-head-row data-v-32c48fa7"><text class="section-title data-v-32c48fa7">到店位置</text><view class="map-actions data-v-32c48fa7"><text wx:if="{{a}}" class="map-action data-v-32c48fa7" bindtap="{{b}}">驾车路线</text><text wx:if="{{c}}" class="map-action data-v-32c48fa7" bindtap="{{d}}">打开地图</text></view></view><view wx:if="{{e}}" class="map-wrap data-v-32c48fa7"><map class="map data-v-32c48fa7" latitude="{{f}}" longitude="{{g}}" scale="{{16}}" markers="{{h}}" include-points="{{i}}" polyline="{{j}}" show-location="{{k}}" enable-scroll="{{true}}" enable-zoom="{{true}}" bindmarkertap="{{l}}"/></view><view class="location-card data-v-32c48fa7"><text class="location-name data-v-32c48fa7">{{m}}</text><text class="location-address data-v-32c48fa7">{{n}}</text><text wx:if="{{o}}" class="location-empty data-v-32c48fa7">当前地点未配置经纬度，暂不显示地图。</text></view><view wx:if="{{p}}" class="planner-card data-v-32c48fa7"><view class="planner-head data-v-32c48fa7"><text class="planner-title data-v-32c48fa7">驾车路线规划</text><text class="planner-subtitle data-v-32c48fa7">将使用当前位置到景点位置生成路线</text></view><button class="planner-button data-v-32c48fa7" size="mini" loading="{{q}}" bindtap="{{r}}">使用当前位置规划路线</button><text wx:if="{{s}}" class="planner-error data-v-32c48fa7">{{t}}</text><view wx:elif="{{v}}" class="planner-summary data-v-32c48fa7"><text class="planner-summary-text data-v-32c48fa7">距离 {{w}}</text><text class="planner-summary-text data-v-32c48fa7">预计 {{x}}</text></view><view wx:if="{{y}}" class="planner-steps data-v-32c48fa7"><text wx:for="{{z}}" wx:for-item="item" wx:key="c" class="planner-step data-v-32c48fa7">{{item.a}}. {{item.b}}</text></view><text wx:else class="planner-tip data-v-32c48fa7">首次使用会申请定位权限，用于获取你的当前位置。</text></view></view>