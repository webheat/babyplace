<view class="page data-v-0a8ca5dc"><view wx:if="{{a}}" class="state data-v-0a8ca5dc">加载中...</view><view wx:elif="{{b}}" class="state error data-v-0a8ca5dc">{{c}}</view><view wx:elif="{{d}}" class="state data-v-0a8ca5dc">未找到地点</view><view wx:else class="content data-v-0a8ca5dc"><view class="head-card data-v-0a8ca5dc"><text class="title data-v-0a8ca5dc">{{e}}</text><text class="address data-v-0a8ca5dc">{{f}} {{g}} {{h}}</text><rating-stars wx:if="{{i}}" class="data-v-0a8ca5dc" u-i="0a8ca5dc-0" bind:__l="__l" u-p="{{i}}"/><tag-list wx:if="{{j}}" class="data-v-0a8ca5dc" u-i="0a8ca5dc-1" bind:__l="__l" u-p="{{j}}"/></view><view class="section data-v-0a8ca5dc"><text class="section-title data-v-0a8ca5dc">推荐理由</text><text class="paragraph data-v-0a8ca5dc">{{k}}</text></view><route-planner-card wx:if="{{l}}" class="data-v-0a8ca5dc" u-i="0a8ca5dc-2" bind:__l="__l" u-p="{{l}}"/><view class="section data-v-0a8ca5dc"><text class="section-title data-v-0a8ca5dc">用户评价</text><view class="review-form data-v-0a8ca5dc"><input class="input data-v-0a8ca5dc" placeholder="昵称（可选）" value="{{m}}" bindinput="{{n}}"/><input class="input data-v-0a8ca5dc" placeholder="说点真实体验..." value="{{o}}" bindinput="{{p}}"/><picker class="data-v-0a8ca5dc" mode="selector" range="{{r}}" bindchange="{{s}}"><view class="picker data-v-0a8ca5dc">评分：{{q}} 星</view></picker><button class="button data-v-0a8ca5dc" size="mini" loading="{{t}}" bindtap="{{v}}">提交评价</button></view><view wx:if="{{w}}" class="state small data-v-0a8ca5dc">暂无评价</view><view wx:else class="review-list data-v-0a8ca5dc"><view wx:for="{{x}}" wx:for-item="item" wx:key="e" class="review-item data-v-0a8ca5dc"><view class="review-head data-v-0a8ca5dc"><text class="name data-v-0a8ca5dc">{{item.a}}</text><rating-stars wx:if="{{item.c}}" class="data-v-0a8ca5dc" u-i="{{item.b}}" bind:__l="__l" u-p="{{item.c}}"/></view><text class="comment data-v-0a8ca5dc">{{item.d}}</text></view></view></view></view></view>