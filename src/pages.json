{
  "easycom": {
    "^u-(.*)": "@/uview-ui/components/u-$1/u-$1.vue"
  },
  "pages": [
    {
      "path": "pages/index/index",
      "onReachBottomDistance": 300,
      "style": {
        "enablePullDownRefresh": true,
        "enableShareAppMessage": true,
        "enableShareTimeline": true
      }
    },
    {
      "path": "pages/ele/ele",
      "onReachBottomDistance": 300,
      "style": {
        "navigationStyle": "custom",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/meituan/meituan",
      "onReachBottomDistance": 300,
      "style": {
        "navigationStyle": "custom",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/life/arrive/arrive",
      "onReachBottomDistance": 300,
      "style": {
        "navigationStyle": "custom",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/user/mine/mine",
      "style": {}
    },
    {
      "path": "pages/life/shop/shop",
      "style": {
        "enablePullDownRefresh": true,
        "enableShareAppMessage": true,
        "enableShareTimeline": true
      }
    },
    {
      "path": "pages/index/debug",
      "onReachBottomDistance": 300
    }
  ],
  "subPackages": [
    {
      "root": "pages/user/setting",
      "pages": [
        {
          "path": "modifyPassword",
          "style": {
            "navigationBarTitleText": "修改密码",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "forgetPassword",
          "style": {
            "navigationBarTitleText": "忘记密码",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/common/article",
      "pages": [
        {
          "path": "article",
          "style": {
            "navigationBarTitleText": "详情",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "list",
          "style": {
            "navigationBarTitleText": "资讯",
            "enablePullDownRefresh": true
          },
          "onReachBottomDistance": 300
        }
      ]
    },
    {
      "root": "pages/user/mine/feedback",
      "pages": [
        {
          "path": "feedback",
          "style": {
            "navigationBarTitleText": "意见反馈",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/user/mine/info",
      "pages": [
        {
          "path": "idcard/idcard",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "qrcode/qrcode",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "changephone/changephone",
          "style": {
            "navigationBarTitleText": "修改手机号",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "userinfo/userinfo",
          "style": {
            "navigationBarTitleText": "个人信息",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/taobao",
      "pages": [
        {
          "path": "taobao",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "tbk/tbk",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "tbk/search/search",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "tbk/searchGoodsList/searchGoodsList",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "tbk/goodsDetails/goodsDetails",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/poi",
      "pages": [
        {
          "path": "list",
          "aliasPath": "/poi/list",
          "style": {
            "navigationBarTitleText": "地点列表"
          }
        },
        {
          "path": "detail",
          "aliasPath": "/poi/detail",
          "style": {
            "navigationBarTitleText": "地点详情",
            "enableShareAppMessage": true,
            "enableShareTimeline": true
          }
        }
      ]
    },
    {
      "root": "pages/video",
      "pages": [
        {
          "path": "capture",
          "style": {
            "navigationBarTitleText": "生成遛娃视频"
          }
        },
        {
          "path": "preview",
          "style": {
            "navigationBarTitleText": "视频预览",
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pages/chat",
      "pages": [
        {
          "path": "chat",
          "style": {
            "navigationBarTitleText": "在线客服",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/admin",
      "pages": [
        {
          "path": "index",
          "aliasPath": "/admin",
          "style": {
            "navigationBarTitleText": "后台管理"
          }
        },
        {
          "path": "events",
          "aliasPath": "/admin/events",
          "style": {
            "navigationBarTitleText": "联盟埋点"
          }
        }
      ]
    },
    {
      "root": "pages/message",
      "pages": [
        {
          "path": "message/message",
          "style": {
            "navigationBarTitleText": "消息",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "sysmessage/sysmessage",
          "style": {
            "navigationBarTitleText": "消息",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/common/poster",
      "pages": [
        {
          "path": "poster",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/user/login",
      "pages": [
        {
          "path": "login",
          "style": {
            "navigationBarTitleText": "",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/user/homepage",
      "pages": [
        {
          "path": "homepage",
          "style": {}
        }
      ]
    },
    {
      "root": "pages/auth",
      "pages": [
        {
          "path": "index",
          "aliasPath": "/auth",
          "style": {
            "navigationBarTitleText": "登录接入中心"
          }
        },
        {
          "path": "wechat-h5",
          "aliasPath": "/wechat-login",
          "style": {
            "navigationBarTitleText": "微信扫码登录"
          }
        }
      ]
    },
    {
      "root": "pages/webview/webview",
      "pages": [
        {
          "path": "webview",
          "style": {}
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "爱享",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF"
  },
  "tabBar": {
    "color": "#7F8389",
    "selectedColor": "#2979ff",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "/static/tab/home.png",
        "selectedIconPath": "/static/tab/home-selected.png"
      },
      {
        "pagePath": "pages/ele/ele",
        "text": "饿了么",
        "iconPath": "/static/tab/ele.png",
        "selectedIconPath": "/static/tab/ele-selected.png"
      },
      {
        "pagePath": "pages/life/arrive/arrive",
        "text": "吃喝玩乐",
        "iconPath": "/static/tab/life.png",
        "selectedIconPath": "/static/tab/life-selected.png"
      },
      {
        "pagePath": "pages/meituan/meituan",
        "text": "美团",
        "iconPath": "/static/tab/meituan.png",
        "selectedIconPath": "/static/tab/meituan-selected.png"
      },
      {
        "pagePath": "pages/user/mine/mine",
        "text": "我的",
        "iconPath": "/static/tab/my.png",
        "selectedIconPath": "/static/tab/my-selected.png"
      }
    ]
  }
}
