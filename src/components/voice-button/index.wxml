<view class="voice-btn-wrap">
  <!-- 语音按钮 -->
  <view
    class="voice-btn {{isListening ? 'listening' : ''}} {{disabled ? 'disabled' : ''}}"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
    catchtouchmove="onTouchMove"
  >
    <text class="voice-icon">{{ isListening ? '🎙️' : '🎤' }}</text>
    <view wx:if="{{isListening}}" class="pulse-ring"></view>
  </view>

  <!-- 识别状态提示 -->
  <view wx:if="{{isListening}}" class="voice-status">
    <view class="status-dot"></view>
    <text class="status-text">正在聆听... {{duration}}s</text>
    <text wx:if="{{realtimeText}}" class="realtime-text">{{realtimeText}}</text>
  </view>
</view>
